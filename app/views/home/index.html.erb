<div style="
  background-image:
    linear-gradient(rgba(10, 25, 70, 0.65), rgba(10, 25, 70, 0.65)),
    url('<%= asset_path("pillars.jpg") %>');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-repeat: no-repeat;
  min-height: 100vh;
  padding: 30px 0;
">
  
<div class="container py-5">

  <!-- WELCOME SECTION -->
  <div class="p-5 mb-5 rounded-4 text-white shadow"
       style="background: linear-gradient(to bottom, #4169E1, #173591);">

    <div class="row align-items-center">

      <div class="col-md-7">

        <h1 class="display-2 fw-bold" style="color: #D4AF37; font-family: 'Times New Roman', serif;">
          Welcome to myAdnu-Larp
        </h1>
 
        <h4 class="mt-3" style="font-family: 'Times New Roman', serif;">
          Larp Larp Sahur
        </h4>

        <button class="btn btn-primary">
  <a href="https://youtu.be/rwAg0klZlAA?list=RDrwAg0klZlAA" target="_blank" class="text-white text-decoration-none">WATCH THIS!!! IMPORTANT</a>
</button>

<button class="btn btn-primary">
  <a href="https://youtu.be/t4Z9taGAbZQ?list=RDt4Z9taGAbZQ" target="_blank" class="text-white text-decoration-none">WATCH THIS!!! SUPER IMPORTANT </a>
</button>

        <p class="fs-5 mt-4" style="font-family: 'Times New Roman', serif;">
          Manage your school records all in one place.
          Access students, departments, teachers,
          and academic information easily.
        </p>

      </div>

      <div class="col-md-5 text-center">

      </div>

    </div>

  </div>


  <!-- DASHBOARD SECTION -->

  <h2 class="fw-bold mb-4" style="color: #FFFFFF; font-family: 'Times New Roman', serif;">
    School Management
  </h2>

  <div class="row g-4">

    <!-- STUDENTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>🎓</h3>

          <h4 class="card-title">Students</h4>

          <p class="card-text">
            View and manage student records.
          </p>

          <%= link_to "View Students", students_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- DEPARTMENTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>🏛 ️</h3>

          <h4 class="card-title">Departments</h4>

          <p class="card-text">
            Explore academic departments.
          </p>

          <%= link_to "Explore", departments_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- TEACHERS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>👨‍🏫</h3>

          <h4 class="card-title">Teachers</h4>

          <p class="card-text">
            View faculty and staff information.
          </p>

          <%= link_to "View Staff", teachers_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- SUBJECTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>📚</h3>

          <h4 class="card-title">Subjects</h4>

          <p class="card-text">
            Browse available academic subjects.
          </p>

          <%= link_to "View Subjects", subjects_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- SECTIONS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>📋</h3>

          <h4 class="card-title">Sections</h4>

          <p class="card-text">
            Manage student sections.
          </p>

          <%= link_to "View Sections", sections_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- CLASS LISTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>📝</h3>

          <h4 class="card-title">Class Lists</h4>

          <p class="card-text">
            Access organized class lists.
          </p>

          <%= link_to "View Classes", classlists_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- LABORATORIES -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>💻</h3>

          <h4 class="card-title">Laboratories</h4>

          <p class="card-text">
            Explore available school laboratories.
          </p>

          <%= link_to "View Laboratories", laboratories_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>

  </div>

</div>

<!-- CHARTS DASHBOARD -->

<h2 class="fw-bold mt-5 mx-4" style="color: #FFFFFF; ">
  Student Analytics
</h2>

<div class="mx-4 row g-4">

  <!-- STUDENTS PER YEAR LEVEL -->

  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">

      <div class="card-body">

        <h4 class="card-title mb-4">
          Students per Year Level
        </h4>

        <%= column_chart @students_by_year_level,
            xtitle: "Year Level",
            ytitle: "Students",
            height: "350px",
            colors: ["#4169E1"] %>

      </div>
    </div>
  </div>


  <!-- STUDENTS PER DEPARTMENT -->

  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">

      <div class="card-body">

        <h4 class="card-title mb-4">
          Students per Department
        </h4>

        <%= pie_chart @students_by_department,
            height: "350px",
            legend: "bottom",
            colors: ["#4169E1", "#E63916", "#2A9D8F", "#D4AF37"] %>

      </div>
    </div>
  </div>

</div>

