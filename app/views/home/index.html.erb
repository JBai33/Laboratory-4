  <div class="container py-5">

  <!-- WELCOME SECTION -->
  <div class="p-5 mb-5 rounded-4 text-white shadow"
       style="background: linear-gradient(to bottom, #4169E1, #173591);">

    <div class="row align-items-center">

      <div class="col-md-7">

        <h1 class="display-2 fw-bold" style="color: #D4AF37; font-family: 'Times New Roman', serif;">
          Welcome to myAdnu-Lite
        </h1>

        <h4 class="mt-3" style="font-family: 'Times New Roman', serif;">
          Primum Regnum Dei.
        </h4>

        <p class="fs-5 mt-4" style="font-family: 'Times New Roman', serif;">
          Manage your school records all in one place.
          Access students, departments, teachers,
          and academic information easily.
        </p>

      </div>

      <div class="col-md-5 text-center">

      </div>

    </div>

  </div>


  <!-- DASHBOARD SECTION -->

  <h2 class="fw-bold mb-4">
    School Management
  </h2>

  <div class="row g-4">

    <!-- STUDENTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>🎓</h3>

          <h4 class="card-title">Students</h4>

          <p class="card-text">
            View and manage student records.
          </p>

          <%= link_to "View Students", students_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- DEPARTMENTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>🏫</h3>

          <h4 class="card-title">Departments</h4>

          <p class="card-text">
            Explore academic departments.
          </p>

          <%= link_to "Explore", departments_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- TEACHERS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>👨‍🏫</h3>

          <h4 class="card-title">Teachers</h4>

          <p class="card-text">
            View faculty and staff information.
          </p>

          <%= link_to "View Staff", teachers_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- SUBJECTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>📚</h3>

          <h4 class="card-title">Subjects</h4>

          <p class="card-text">
            Browse available academic subjects.
          </p>

          <%= link_to "View Subjects", subjects_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- SECTIONS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>📋</h3>

          <h4 class="card-title">Sections</h4>

          <p class="card-text">
            Manage student sections.
          </p>

          <%= link_to "View Sections", sections_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- CLASS LISTS -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>📝</h3>

          <h4 class="card-title">Class Lists</h4>

          <p class="card-text">
            Access organized class lists.
          </p>

          <%= link_to "View Classes", classlists_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>


    <!-- LABORATORIES -->

    <div class="col-md-4">
      <div class="card shadow-sm h-100 border-0">

        <div class="card-body text-center p-4">

          <h3>💻</h3>

          <h4 class="card-title">Laboratories</h4>

          <p class="card-text">
            Explore available school laboratories.
          </p>

          <%= link_to "View Laboratories", laboratories_path,
              class: "btn btn-primary" %>

        </div>
      </div>
    </div>

  </div>

</div>

