<div id="<%= dom_id teacher %>">
  <div>
    <strong>Name:</strong>
    <%= teacher.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= teacher.email %>
  </div>

  <div>
    <strong>Specialization:</strong>
    <%= teacher.specialization %>
  </div>

  <div>
    <strong>Department:</strong>
    <%= teacher.department.name %>
  </div>

  <div>
    <strong>Monthly Salary:</strong>
    <%= number_to_currency(teacher.monthly_salary) %>
  </div>

  <div>
    <strong>Unit per Rate:</strong>
    <%= number_to_currency(teacher.unit_per_rate) %>
  </div>

</div>
