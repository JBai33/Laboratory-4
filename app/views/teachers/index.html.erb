<% content_for :title, "Teachers" %>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<h1>Teachers</h1>

<div id="teachers" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Specialization</th>
        <th>Department</th>
        <th>Monthly Salary</th>
        <th>Unit Per Rate</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @teachers.each do |teacher| %>
        <tr id="<%= dom_id teacher %>">
          <td><%= teacher.name %></td>
          <td><%= teacher.email %></td>
          <td><%= teacher.specialization %></td>
          <td><%= teacher.department.name %></td>
          <td><%= number_to_currency teacher.monthly_salary, unit: "P" %></td>
          <td><%= number_to_currency teacher.unit_per_rate, unit: "P" %></td>

          <td class="text-nowrap">
            <%= button_to "Show",
                          teacher,
                          method: :get,
                          class: "btn btn-sm btn-primary",
                          form_class: "d-inline-block" %>

            <%= button_to "Edit",
                          edit_teacher_path(teacher),
                          method: :get,
                          class: "btn btn-sm btn-secondary",
                          form_class: "d-inline-block" %>

            <%= button_to "Delete",
                          teacher,
                          method: :delete,
                          class: "btn btn-sm btn-danger",
                          form_class: "d-inline-block" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New teacher",
            new_teacher_path,
            class: "btn btn-success" %>