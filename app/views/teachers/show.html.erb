<% content_for :title, @teacher.name %>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% if alert.present? %>
  <div class="alert alert-danger"><%= alert %></div>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
  <div>
    <h1 class="mb-1"><%= @teacher.name %></h1>

    <p class="text-muted mb-0">
      <%= @teacher.specialization %> &middot;
      <%= @teacher.department.name %>
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Edit",
                edit_teacher_path(@teacher),
                class: "btn btn-secondary" %>

    <%= link_to "Back to Teachers",
                teachers_path,
                class: "btn btn-outline-secondary" %>

    <%= button_to "Delete",
                  @teacher,
                  method: :delete,
                  class: "btn btn-danger" %>
  </div>
</div>


<div class="row g-3 mb-4">

  <!-- Teacher Details -->

  <div class="col-md-6">
    <div class="card h-100">

      <div class="card-header">
        Teacher Details
      </div>

      <div class="card-body">

        <div class="row mb-2">
          <div class="col-5 text-muted">
            Name
          </div>

          <div class="col-7 fw-bold">
            <%= @teacher.name %>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-5 text-muted">
            Email
          </div>

          <div class="col-7">
            <%= @teacher.email %>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-5 text-muted">
            Specialization
          </div>

          <div class="col-7">
            <%= @teacher.specialization %>
          </div>
        </div>

        <div class="row">
          <div class="col-5 text-muted">
            Department
          </div>

          <div class="col-7">
            <%= @teacher.department.name %>
          </div>
        </div>

      </div>
    </div>
  </div>


  <!-- Salary Summary -->

  <div class="col-md-6">
    <div class="card h-100">

      <div class="card-header">
        Compensation Summary
      </div>

      <div class="card-body">

        <div class="row text-center">

          <div class="col">
            <div class="fs-3 fw-bold">
              <%= number_to_currency @teacher.monthly_salary, unit: "P" %>
            </div>

            <div class="small text-muted">
              Monthly Salary
            </div>
          </div>

          <div class="col border-start">
            <div class="fs-3 fw-bold">
              <%= number_to_currency @teacher.unit_per_rate, unit: "P" %>
            </div>

            <div class="small text-muted">
              Unit Per Rate
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>

</div>


<!-- Subjects -->

<div class="card mb-4">

  <div class="card-header d-flex justify-content-between align-items-center">

    <span>Subjects</span>

    <span class="badge text-bg-secondary">
      <%= @teacher.subjects.size %>
    </span>

  </div>


  <% if @teacher.subjects.any? %>

    <div class="table-responsive">

      <table class="table table-striped table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Subject</th>
            <th>Units</th>
          </tr>
        </thead>

        <tbody>

          <% @teacher.subjects.each do |subject| %>

            <tr>
              <td>
                <%= subject.name %>
              </td>

              <td>
                <%= subject.number_of_units %>
              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="card-body text-muted">
      This teacher is not assigned to any subject yet.
    </div>

  <% end %>

</div>