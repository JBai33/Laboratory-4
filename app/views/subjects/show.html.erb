<% content_for :title, @subject.name %>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% if alert.present? %>
  <div class="alert alert-danger"><%= alert %></div>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">

  <div>
    <h1 class="mb-1">
      <%= @subject.name %>
    </h1>

    <p class="text-muted mb-0">
      <%= @subject.teacher.name %>
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">

    <%= link_to "Edit",
                edit_subject_path(@subject),
                class: "btn btn-secondary" %>

    <%= link_to "Back to Subjects",
                subjects_path,
                class: "btn btn-outline-secondary" %>

    <%= button_to "Delete",
                  @subject,
                  method: :delete,
                  class: "btn btn-danger" %>

  </div>
</div>


<!-- Subject Details and Summary -->

<div class="row g-3 mb-4">

  <!-- Subject Details -->

  <div class="col-md-6">

    <div class="card h-100">

      <div class="card-header">
        Subject Details
      </div>

      <div class="card-body">

        <div class="row mb-2">

          <div class="col-5 text-muted">
            Name
          </div>

          <div class="col-7 fw-bold">
            <%= @subject.name %>
          </div>

        </div>


        <div class="row mb-2">

          <div class="col-5 text-muted">
            Teacher
          </div>

          <div class="col-7">
            <%= @subject.teacher.name %>
          </div>

        </div>


        <div class="row">

          <div class="col-5 text-muted">
            Number of Units
          </div>

          <div class="col-7">
            <%= @subject.number_of_units %>
          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- Subject Summary -->

  <div class="col-md-6">

    <div class="card h-100">

      <div class="card-header">
        Subject Summary
      </div>

      <div class="card-body">

        <div class="row text-center">

          <div class="col">

            <div class="fs-3 fw-bold">
              <%= @subject.number_of_units %>
            </div>

            <div class="small text-muted">
              Units
            </div>

          </div>


          <div class="col border-start">

            <div class="fs-3 fw-bold">
              <%= number_to_currency @subject.per_unit_rate, unit: "P" %>
            </div>

            <div class="small text-muted">
              Per Unit Rate
            </div>

          </div>


          <div class="col border-start">

            <div class="fs-3 fw-bold">
              <%= @subject.section_count %>
            </div>

            <div class="small text-muted">
              Sections
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>


<!-- Sections -->

<div class="card mb-4">

  <div class="card-header d-flex justify-content-between align-items-center">

    <span>Sections</span>

    <span class="badge text-bg-secondary">
      <%= @subject.sections.size %>
    </span>

  </div>


  <% if @subject.sections.any? %>

    <div class="table-responsive">

      <table class="table table-striped table-hover align-middle mb-0">

        <thead>

          <tr>
            <th>Section</th>
            <th>Room</th>
            <th>Timeslot</th>
            <th>Students</th>
          </tr>

        </thead>

        <tbody>

          <% @subject.sections.each do |section| %>

            <tr>

              <td>
                <%= section.name %>
              </td>

              <td>
                <%= section.room %>
              </td>

              <td>
                <%= section.timeslot %>
              </td>

              <td>
                <%= section.student_count %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="card-body text-muted">
      This subject does not have any sections yet.
    </div>

  <% end %>

</div>