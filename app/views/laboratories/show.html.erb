<% content_for :title, @laboratory.name %>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% if alert.present? %>
  <div class="alert alert-danger"><%= alert %></div>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
  <div>
    <h1 class="mb-1"><%= @laboratory.name %></h1>
    <p class="text-muted mb-0">
      <%= @laboratory.location %> &middot;
      <%= @laboratory.department.name %>
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Edit",
                edit_laboratory_path(@laboratory),
                class: "btn btn-secondary" %>

    <%= link_to "Back to Laboratories",
                laboratories_path,
                class: "btn btn-outline-secondary" %>

    <%= button_to "Delete",
                  @laboratory,
                  method: :delete,
                  class: "btn btn-danger" %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        Laboratory Details
      </div>

      <div class="card-body">
        <div class="row mb-2">
          <div class="col-5 text-muted">Name</div>
          <div class="col-7 fw-bold">
            <%= @laboratory.name %>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-5 text-muted">Location</div>
          <div class="col-7">
            <%= @laboratory.location %>
          </div>
        </div>

        <div class="row">
          <div class="col-5 text-muted">Department</div>
          <div class="col-7">
            <%= @laboratory.department.name %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">
        Department Information
      </div>

      <div class="card-body">
        <div class="row mb-2">
          <div class="col-5 text-muted">Department</div>
          <div class="col-7 fw-bold">
            <%= @laboratory.department.name %>
          </div>
        </div>

        <div class="row">
          <div class="col-5 text-muted">Location</div>
          <div class="col-7">
            <%= @laboratory.department.location %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    Laboratory Summary
  </div>

  <div class="card-body">
    <div class="row text-center">
      <div class="col">
        <div class="fs-3 fw-bold">
          <%= @laboratory.name %>
        </div>
        <div class="small text-muted">
          Laboratory
        </div>
      </div>

      <div class="col border-start">
        <div class="fs-3 fw-bold">
          <%= @laboratory.department.name %>
        </div>
        <div class="small text-muted">
          Department
        </div>
      </div>

      <div class="col border-start">
        <div class="fs-3 fw-bold">
          <%= @laboratory.location %>
        </div>
        <div class="small text-muted">
          Location
        </div>
      </div>
    </div>
  </div>
</div>