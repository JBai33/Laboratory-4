<% content_for :title, @department.name %>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% if alert.present? %>
  <div class="alert alert-danger"><%= alert %></div>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
  <div>
    <h1 class="mb-1"><%= @department.name %></h1>

    <p class="text-muted mb-0">
      <%= @department.location %>
    </p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Edit",
                edit_department_path(@department),
                class: "btn btn-secondary" %>

    <%= link_to "Back to Departments",
                departments_path,
                class: "btn btn-outline-secondary" %>

    <%= button_to "Delete",
                  @department,
                  method: :delete,
                  class: "btn btn-danger" %>
  </div>
</div>


<!-- Department Details and Summary -->

<div class="row g-3 mb-4">

  <div class="col-md-6">
    <div class="card h-100">

      <div class="card-header">
        Department Details
      </div>

      <div class="card-body">

        <div class="row mb-2">
          <div class="col-5 text-muted">Name</div>
          <div class="col-7 fw-bold">
            <%= @department.name %>
          </div>
        </div>

        <div class="row">
          <div class="col-5 text-muted">Location</div>
          <div class="col-7">
            <%= @department.location %>
          </div>
        </div>

      </div>
    </div>
  </div>


  <div class="col-md-6">
    <div class="card h-100">

      <div class="card-header">
        Department Summary
      </div>

      <div class="card-body">

        <div class="row text-center">

          <div class="col">
            <div class="fs-3 fw-bold">
              <%= @department.students_count %>
            </div>

            <div class="small text-muted">
              Students
            </div>
          </div>


          <div class="col border-start">
            <div class="fs-3 fw-bold">
              <%= @department.teachers_count %>
            </div>

            <div class="small text-muted">
              Teachers
            </div>
          </div>


          <div class="col border-start">
            <div class="fs-3 fw-bold">
              <%= @department.laboratories_count %>
            </div>

            <div class="small text-muted">
              Laboratories
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>

</div>


<!-- Students -->

<div class="card mb-4">

  <div class="card-header d-flex justify-content-between align-items-center">

    <span>Students</span>

    <span class="badge text-bg-secondary">
      <%= @department.students.size %>
    </span>

  </div>


  <% if @department.students.any? %>

    <div class="table-responsive">

      <table class="table table-striped table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Name</th>
            <th>Program</th>
            <th>Year Level</th>
          </tr>
        </thead>

        <tbody>

          <% @department.students.each do |student| %>

            <tr>
              <td>
                <%= student.name %>
              </td>

              <td>
                <%= student.program %>
              </td>

              <td>
                <%= student.year_level %>
              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="card-body text-muted">
      No students are assigned to this department yet.
    </div>

  <% end %>

</div>


<!-- Teachers -->

<div class="card mb-4">

  <div class="card-header d-flex justify-content-between align-items-center">

    <span>Teachers</span>

    <span class="badge text-bg-secondary">
      <%= @department.teachers.size %>
    </span>

  </div>


  <% if @department.teachers.any? %>

    <div class="table-responsive">

      <table class="table table-striped table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Specialization</th>
          </tr>
        </thead>

        <tbody>

          <% @department.teachers.each do |teacher| %>

            <tr>
              <td>
                <%= teacher.name %>
              </td>

              <td>
                <%= teacher.email %>
              </td>

              <td>
                <%= teacher.specialization %>
              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="card-body text-muted">
      No teachers are assigned to this department yet.
    </div>

  <% end %>

</div>


<!-- Laboratories -->

<div class="card mb-4">

  <div class="card-header d-flex justify-content-between align-items-center">

    <span>Laboratories</span>

    <span class="badge text-bg-secondary">
      <%= @department.laboratories.size %>
    </span>

  </div>


  <% if @department.laboratories.any? %>

    <div class="table-responsive">

      <table class="table table-striped table-hover align-middle mb-0">

        <thead>
          <tr>
            <th>Name</th>
            <th>Location</th>
          </tr>
        </thead>

        <tbody>

          <% @department.laboratories.each do |laboratory| %>

            <tr>
              <td>
                <%= laboratory.name %>
              </td>

              <td>
                <%= laboratory.location %>
              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="card-body text-muted">
      No laboratories are assigned to this department yet.
    </div>

  <% end %>

</div>