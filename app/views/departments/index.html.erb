<% content_for :title, "Departments" %>

<% if notice.present? %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<h1>Departments</h1>

<div id="departments" class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Location</th>
        <th>Students</th>
        <th>Teachers</th>
        <th>Laboratories</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @departments.each do |department| %>
        <tr id="<%= dom_id department %>">
          <td><%= department.name %></td>
          <td><%= department.location %></td>
          <td><%= department.students_count %></td>
          <td><%= department.teachers_count %></td>
          <td><%= department.laboratories_count %></td>

          <td class="text-nowrap">
            <%= button_to "Show",
                          department,
                          method: :get,
                          class: "btn btn-sm btn-primary",
                          form_class: "d-inline-block" %>

            <%= button_to "Edit",
                          edit_department_path(department),
                          method: :get,
                          class: "btn btn-sm btn-secondary",
                          form_class: "d-inline-block" %>

            <%= button_to "Delete",
                          department,
                          method: :delete,
                          class: "btn btn-sm btn-danger",
                          form_class: "d-inline-block" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New department",
            new_department_path,
            class: "btn btn-success" %>