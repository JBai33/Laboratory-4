<%= form_with(model: department) do |form| %>
  <% if department.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(department.errors.count, "error") %> prohibited this department from being saved:</h2>

      <ul>
        <% department.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :location, style: "display: block" %>
    <%= form.text_field :location %>
  </div>

  <div>
    <%= form.label :students_count, "Number of Students", style: "display: block" %>
    <%= form.number_field :students_count %>
  </div>

  <div>
    <%= form.label :teachers_count, "Number of Teachers", style: "display: block" %>
    <%= form.number_field :teachers_count %>
  </div>

  <div>
    <%= form.label :laboratories_count, "Number of Laboratories", style: "display: block" %>
    <%= form.number_field :laboratories_count %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
