<div id="<%= dom_id department %>">
  <div>
    <strong>Name:</strong>
    <%= department.name %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= department.location %>
  </div>

  <div>
    <strong>Number of Students:</strong>
    <%= department.students_count %>
  </div>

  <div>
    <strong>Number of Teachers:</strong>
    <%= department.teachers_count %>
  </div>

  <div>
    <strong>Number of Laboratories:</strong>
    <%= department.laboratories_count %>
  </div>

</div>
